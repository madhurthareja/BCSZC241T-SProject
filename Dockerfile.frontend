# syntax=docker/dockerfile:1.6
# Frontend container: build the Vite app, then serve via nginx.
# A single nginx config is rendered at build time with BACKEND_URL
# substituted in, so the same image works for both docker-compose
# (default backend URL is the compose service name) and any external
# deployment where the backend lives at a different URL.
FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

ARG BACKEND_URL=http://backend:8000

COPY --from=build /app/dist /usr/share/nginx/html

# Inline nginx config with $BACKEND_URL expanded by the RUN shell.
RUN BACKEND_URL="${BACKEND_URL}" sh -c 'cat > /etc/nginx/conf.d/default.conf' <<'NGINX'
server {
    listen 8080;
    server_name _;

    client_max_body_size 250m;

    root /usr/share/nginx/html;
    index index.html;

    proxy_read_timeout  600s;
    proxy_send_timeout  600s;
    send_timeout        600s;

    location /api/ {
        proxy_pass         __BACKEND_URL__/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpe?g|gif|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
NGINX
RUN sed -i "s|__BACKEND_URL__|${BACKEND_URL}|g" /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:8080/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
